{
  "name": "gtg-desktop",
  "productName": "Gate-to-Gate",
  "version": "1.4.6",
  "description": "Gate-to-Gate Analyse – Desktop-App (Videos auf der Festplatte)",
  "author": "Swiss-Ski",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/gate-to-gate/gtg-app",
  "main": "main.js",
  "scripts": {
    "sync": "node sync.js",
    "start": "npm run sync && electron .",
    "mac": "npm run sync && electron-builder --mac dmg --publish never",
    "win": "npm run sync && electron-builder --win nsis --publish never",
    "dist": "npm run sync && electron-builder -mw --publish never"
  },
  "build": {
    "appId": "ch.swiss-ski.gatetogate",
    "productName": "Gate-to-Gate",
    "publish": [ { "provider": "github", "owner": "gate-to-gate", "repo": "gtg-app" } ],
    "afterPack": "afterPack.js",
    "files": [ "main.js", "preload.js", "renderer/**" ],
    "directories": { "output": "dist" },
    "mac": { "target": [ "dmg" ], "category": "public.app-category.sports", "icon": "build/icon.png", "identity": null, "artifactName": "Gate-to-Gate-mac.${ext}" },
    "win": { "target": [ "nsis" ], "icon": "build/icon.ico", "artifactName": "Gate-to-Gate-win.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  }
}
